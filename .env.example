# Copy to .env (gitignored). Required in production.
JWT_SECRET=change-me-to-a-long-random-string
# Required in production so anyone who finds the URL can't self-provision an account.
# Coaches enter this on the sign-up screen. Rotate it if it leaks.
REGISTRATION_CODE=change-me-too
# PORT=3001
# SQLite (default): file path. Set DATABASE_URL instead to use Postgres (also: npm i pg).
# DATABASE_FILE=data/sppi.sqlite
# DATABASE_URL=postgres://user:pass@localhost:5432/sppi
# Set to 1 when running behind a reverse proxy (Nginx) so rate limiting sees client IPs.
# TRUST_PROXY=1
# Session cookies are HTTPS-only in production, so login fails over plain http://.
# Set to 0 ONLY for a temporary HTTP-only pilot; passwords then travel unencrypted.
# COOKIE_SECURE=0
# Bind address. Defaults to 127.0.0.1 when TRUST_PROXY=1 (only the proxy can reach the app), else 0.0.0.0.
# HOST=127.0.0.1
